    \(ptC2 = \ Punto[rtB2C2, rtC2A2]\)}], "Input"],

Cell[BoxData[
    \({\(-a\^2\)\ \((a + b + c)\), 
      b\ \((a + b - c)\)\ \((a + c)\), \((a + b)\)\ c\ \((a - b + 
            c)\)}\)], "Output"],

Cell[BoxData[
