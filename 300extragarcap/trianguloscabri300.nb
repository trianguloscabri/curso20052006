Cell[TextData[{
  "El punto de Clawson del tri\[AAcute]ngulo ",
  StyleBox["ABC",
    FontSlant->"Italic"],
  " es el centro de homotecia entre ",
  StyleBox["A'B'C",
    FontSlant->"Italic"],
  "', tri\[AAcute]ngulo \[OAcute]rtico de ",
  StyleBox["ABC",
    FontSlant->"Italic"],
  ", y ",
  StyleBox["A\"B\"C\"",
    FontSlant->"Italic"],
  ", tri\[AAcute]ngulo extangencial de ",
  StyleBox["ABC",
    FontSlant->"Italic"],
  ". Es el punto X(19) de ",
  StyleBox["ETC",
    FontSlant->"Italic"],
  ". "
}], "Text"],

Cell[BoxData[{
    \(\(<< Baricentricas`\ ;\)\), "\[IndentingNewLine]", 
    \(\(<< Graphics`ImplicitPlot`;\)\)}], "Input"],

Cell["\<\
Hallamos las coordenadas de los v\[EAcute]rtices del  tri\[AAcute]ngulo \
\[OAcute]rtico:\
\>", "Text"],

Cell[BoxData[{
    \(\(ptA1 = Pie[ptA, ptB, ptC];\)\), "\[IndentingNewLine]", 
    \(\(ptB1 = Pie[ptB, ptC, ptA];\)\), "\[IndentingNewLine]", 
    \(\(ptC1 = Pie[ptC, ptA, ptB];\)\)}], "Input"],

Cell["\<\
Ahora, las coordenadas de los v\[EAcute]rtices del  tri\[AAcute]ngulo \
extangencial. Primero hallamos las ecuaciones de las rectas que determinan a \
estos puntos:\
\>", "Text"],

Cell[BoxData[{
    \(\(rtB2C2\  = \ 
        Punto[SimetriaAxial[ptIbX, ptIb, ptIc], 
          SimetriaAxial[ptIcX, ptIb, ptIc]];\)\), "\[IndentingNewLine]", 
    \(\(rtC2A2\  = \ 
        Punto[SimetriaAxial[ptIcY, ptIc, ptIa], 
          SimetriaAxial[ptIaY, ptIc, ptIa]];\)\), "\[IndentingNewLine]", 
    \(\(rtA2B2\  = \ 
        Punto[SimetriaAxial[ptIaZ, ptIa, ptIb], 
          SimetriaAxial[ptIbZ, ptIa, ptIb]];\)\)}], "Input"],

Cell["Ahora hallamos las coordenadas de los puntos:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(ptA2 = \ Punto[rtC2A2, rtA2B2]\), "\[IndentingNewLine]", 
