Cell[BoxData[
    \({a\ \((a - b + c)\)\ \((b + c)\), 
      b\ \((a + c)\)\ \((\(-a\) + b + c)\), \(-c\^2\)\ \((a + b + 
            c)\)}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Det[{\[IndentingNewLine]Recta[ptA1, ptA2], \[IndentingNewLine]Recta[
          ptB1, ptB2], \[IndentingNewLine]Recta[ptC1, ptC2]}]\)], "Input"],

Cell[BoxData[
    \(0\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

