Cell[CellGroupData[{

Cell[BoxData[
    \(Solve[\(-x\) + 5\ x\^2 - 8\ x\^3 + 4\ x\^4 + 5\ y\^2 - 8\ x\ y\^2 + 
          8\ x\^2\ y\^2 + 4\ y\^4 == 0, y]\)], "Input"],

Cell[BoxData[
    \({{y \[Rule] \(-\(\@\(\(-5\) + 8\ x - 8\ x\^2 - \@\(25 - 64\ x + 64\ \
x\^2\)\)\/\(2\ \@2\)\)\)}, {y \[Rule] \@\(\(-5\) + 8\ x - 8\ x\^2 - \@\(25 - \
64\ x + 64\ x\^2\)\)\/\(2\ \@2\)}, {y \[Rule] \(-\@\(\(-\(5\/8\)\) + x - x\^2 \
+ 1\/8\ \@\(25 - 64\ x + 64\ x\^2\)\)\)}, {y \[Rule] \@\(\(-\(5\/8\)\) + x - \
x\^2 + 1\/8\ \@\(25 - 64\ x + 64\ x\^2\)\)}}\)], "Output"]
}, Open  ]],

Cell["sqrt(-(5/8) + a - a^2 + (1/8)*sqrt(25 - 64*a + 64*a^2))", "Input"],

Cell[BoxData[
    \(For[a = 1, 
      a < 100, \(a++\), \[IndentingNewLine]For[b = 1, 
        b < 100, \(b++\), \[IndentingNewLine]For[c = 1, 
          c < 100, \(c++\), \[IndentingNewLine]If[
            a\^4 - a\^2\ b\^2 - a\^2\ c\^2 - 8\ b\^2\ c\^2 \[Equal] 
                0\ \  && \ \ a > \ b + c, Print[{a, b, c}]]]]]\)], "Input"]
},
