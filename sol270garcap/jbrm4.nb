Notebook[{
Cell[BoxData[{
    \(\(s = \(a + b + c\)\/2;\)\), "\[IndentingNewLine]", 
    \(\(S = \@\(s \((s - a)\) \((s - b)\) \((s - c)\)\);\)\), "\
\[IndentingNewLine]", 
    \(\(R = \(a\ b\ c\)\/\(4\ S\);\)\), "\[IndentingNewLine]", 
    \(\(ma = \(1\/2\) \@\(2  b\^2 + 2  c\^2 - a\^2\);\)\)}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Factor[a\^4 - 16\ R\^2\ ma\^2]\)], "Input"],

Cell[BoxData[
    \(\(a\^2\ \((a\^2 - b\^2 - c\^2)\)\ \((a\^4 - a\^2\ b\^2 - a\^2\ c\^2 - 8\
\ b\^2\ c\^2)\)\)\/\(\((a - b - c)\)\ \((a + b - c)\)\ \((a - b + c)\)\ \((a \
+ b + c)\)\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(a2 = 1;\)\), "\[IndentingNewLine]", 
    \(\(b2 = \((x - 1)\)\^2 + y\^2;\)\), "\[IndentingNewLine]", 
    \(\(c2\  = x\^2 + y\^2;\)\), "\[IndentingNewLine]", 
    \(Factor[a2\^2 - a2 \((b2 + c2)\) - 8\ b2\ c2]\)}], "Input"],

Cell[BoxData[
    \(\(-2\)\ \((\(-x\) + 5\ x\^2 - 8\ x\^3 + 4\ x\^4 + 5\ y\^2 - 
          8\ x\ y\^2 + 8\ x\^2\ y\^2 + 4\ y\^4)\)\)], "Output"]
}, Open  ]],

Cell[BoxData[
    \(\(<< Graphics`ImplicitPlot`;\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(curva = 
        ImplicitPlot[\(-x\) + 5\ x\^2 - 8\ x\^3 + 4\ x\^4 + 5\ y\^2 - 
              8\ x\ y\^2 + 8\ x\^2\ y\^2 + 4\ y\^4 == 0, {x, 0, 
            1}, {y, \(-0.5\), 0.5}, 
          AspectRatio \[Rule] Automatic];\)\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
