Cell[CellGroupData[{

Cell["Entonces la ecuaci\[OAcute]n del lugar del punto P es ", "Subsubsection",
  FontWeight->"Plain"],

Cell[BoxData[
    \(\(lugarP = \(x\^2\) \((c\^2\ y\^2 - a\^2\ y\ z + b\^2\ y\ z + 
                c\^2\ y\ z + b\^2\ z\^2)\) - \(a\^2\) \(y\^2\) 
            z\^2;\)\)], "Input",
  CellLabel->"In[13]:="]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Para obtener una figura simple de esta curva consideramos un \
tri\[AAcute]ngulo concreto y definimos una ventana para la figura:\
\>", "Subsubsection",
  FontWeight->"Plain"],

Cell[BoxData[{
    \(\(cA = {0, 3};\)\), "\[IndentingNewLine]", 
    \(\(cB = {\(-4\), \(-1\)};\)\), "\[IndentingNewLine]", 
    \(\(cC = {2, \(-1\)};\)\), "\[IndentingNewLine]", 
    \(\(ampl = 5;\)\), "\[IndentingNewLine]", 
    \(vax = {x, \(-ampl\), ampl}; vay = {y, \(-ampl\), ampl};\)}], "Input",
  CellLabel->"In[14]:="]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ahora dibujamos el tri\[AAcute]ngulo y la curva:", "Subsubsection",
  FontWeight->"Plain"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(triangulo = 
        Graphics[{RGBColor[0, 0, 1], 
            Line[{cA, cB, cC, cA}]}];\)\), "\[IndentingNewLine]", 
    \(\(curvalugarP = 
        ImplicitPlot[BarCar[lugarP \[Equal] 0, cA, cB, cC], vax, vay, 
          DisplayFunction \[Rule] Identity, PlotPoints \[Rule] 100, 
          PlotStyle \[Rule] {AbsoluteThickness[1.7], 
              RGBColor[1, 0, 0]}];\)\), "\[IndentingNewLine]", 
    \(\(Show[{triangulo, curvalugarP}, Axes \[Rule] False, 
        AspectRatio \[Rule] Automatic, ImageSize \[Rule] 400];\)\)}], "Input",\

  CellLabel->"In[19]:="],

Cell[GraphicsData["PostScript", "\<\
