    \(\(Attributes[DrawGraphics] = {HoldAll};\)\), "\n", 
    \(DrawGraphics[plot_] := 
      Block[\[IndentingNewLine]{$DisplayFunction = 
            Identity}, \[IndentingNewLine]First[
          Graphics[plot]]\[IndentingNewLine]]\), "\[IndentingNewLine]", 
    \(CombinarGrafico[primitivas_List, 
        opciones___?OptionQ] := \[IndentingNewLine]Show[Graphics[primitivas], 
        opciones]\)}], "Input"],

Cell[BoxData[
    \(\[IndentingNewLine]\)], "Input"],

