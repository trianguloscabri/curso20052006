Cell[CellGroupData[{
Cell[BoxData[
    \(Factor[\(1 - \((\(\(b\^2\)\(+\)\(c\^2\)\(-\)\(a\^2\)\(\ \)\)\/\(2\ b\ c\
\))\)\^2\)\/\((\(\(a\^2\)\(+\)\(c\^2\)\(-\)\(b\^2\)\(\ \)\)\/\(2\ a\ \
c\))\)\^2 - 
        1\/\((\(\(a\^2\)\(+\)\(b\^2\)\(-\)\(c\^2\)\(\ \)\)\/\(2\ a\ b\))\)\^2 \
+ 1]\)], "Input"],

Cell[BoxData[
    \(\(-\(\(\((a - b - c)\)\ \((a + b - c)\)\ \((a - b + c)\)\ \((a + b + 
                c)\)\ \((a\^3 - a\^2\ b + a\ b\^2 + b\^3 - a\ c\^2 - 
                b\ c\^2)\)\ \((a\^3 + a\^2\ b + a\ b\^2 - b\^3 - a\ c\^2 + 
                b\ c\^2)\)\)\/\(b\^2\ \((a\^2 + b\^2 - c\^2)\)\^2\ \((a\^2 - \
b\^2 + c\^2)\)\^2\)\)\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(\(a = 2;\)\[IndentingNewLine]
    \(b = \@\(\((x - 1)\)\^2 + y\^2\);\)\[IndentingNewLine]
    \(c = \@\(\((x + 1)\)\^2 + y\^2\);\)\[IndentingNewLine]
    ec1 = 
      Factor[a\^3 - a\^2\ b + a\ b\^2 + b\^3 - a\ c\^2 - 
          b\ c\^2]\)\(\ \)\)\)], "Input"],

Cell[BoxData[
    \(8 - 8\ x - 5\ \@\(1 - 2\ x + x\^2 + y\^2\) - 
      2\ x\ \@\(1 - 2\ x + x\^2 + y\^2\) - 
      x\^2\ \@\(1 - 2\ x + x\^2 + y\^2\) - 
      y\^2\ \@\(1 - 2\ x + x\^2 + y\^2\) + \((1 - 2\ x + x\^2 + \
y\^2)\)\^\(3/2\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Simplify[\((\(-5\)\ \@\(1 - 2\ x + x\^2 + y\^2\) - 
            2\ x\ \@\(1 - 2\ x + x\^2 + y\^2\) - 
            x\^2\ \@\(1 - 2\ x + x\^2 + y\^2\) - 
            y\^2\ \@\(1 - 2\ x + x\^2 + y\^2\) + \((1 - 2\ x + x\^2 + y\^2)\)\
\^\(3/2\))\)/\@\(1 - 2\ x + x\^2 + y\^2\)]\)], "Input"],

Cell[BoxData[
    \(\(-4\)\ \((1 + x)\)\)], "Output"]
}, Open  ]],

Cell[BoxData[
    \(Solve[
      8 - 8\ x - 4\ \((1 + x)\) \@\(1 - 2\ x + x\^2 + y\^2\) \[Equal] 0, 
      y]\)], "Input"],

Cell[BoxData[
    \(8 - 8  x\  - \)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Solve[ec1 \[Equal] 0, y]\)], "Input"],

Cell[BoxData[
    \({{y \[Rule] \(-\(\@\(3 - 8\ x + 6\ x\^2 - x\^4\)\/\@\(1 + 2\ x + x\^2\)\
\)\)}, {y \[Rule] \@\(3 - 8\ x + 6\ x\^2 - x\^4\)\/\@\(1 + 2\ x + \
x\^2\)}}\)], "Output"]
}, Open  ]],

Cell[BoxData[
