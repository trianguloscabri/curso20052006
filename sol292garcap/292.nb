                  ptB1}], \[IndentingNewLine]Line[{ptC, 
                  ptC1}]}, \[IndentingNewLine]{DisplayFunction \[Rule] 
                Identity, \[IndentingNewLine]Axes \[Rule] 
                False, \[IndentingNewLine]AspectRatio \[Rule] 
                Automatic, \[IndentingNewLine]ImageSize \[Rule] 
                400, \[IndentingNewLine]PlotRange \[Rule] {\ {\(-1.5\), 
                    1.5}, {\(-0.5\), 3.5}}}]];\)\)], "Input"],

