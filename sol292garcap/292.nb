    \(\(GenerarGrafico[t_]\  := \ 
        Module[{curvaA}, \[IndentingNewLine]\[IndentingNewLine]curvaA = 
            Plot[\@\(3 - 8\ x + 6\ x\^2 - x\^4\)\/\@\(1 + 2\ x + x\^2\), {x, \
\(-0.2\), 0.99}, \ \[IndentingNewLine]AspectRatio \[Rule] Automatic, 
              DisplayFunction \[Rule] Identity, PlotPoints \[Rule] 100, 
              PlotStyle \[Rule] {AbsoluteThickness[2.7], 
                  RGBColor[1, 0, 
                    0]}]; \[IndentingNewLine]ptA = {t, \@\(3 - 8\ t + 6\ t\^2 \
- t\^4\)\/\(1 + t\)}; ptB = {\(-1\), 0}; 
          ptC = {1, 0}; \[IndentingNewLine]ptA1 = {t, 
              0}; \[IndentingNewLine]ptB1 = \ \((ptA + ptC)\)/
              2; \[IndentingNewLine]ptC1 = 
            PuntoBarCar[{a, b, 0}, ptA, ptB, 
              ptC]; \[IndentingNewLine]CombinarGrafico[{\[IndentingNewLine]\
Line[{ptA, ptB, ptC, ptA}], \[IndentingNewLine]curvaA\  // \ 
                DrawGraphics, \[IndentingNewLine]Line[{{0, 0}, {0, 
                    3}}], \[IndentingNewLine]RGBColor[0, 0, 
                1], \[IndentingNewLine]Line[{ptA, 
