    \(\(PuntoBarCar[{u_, v_, w_}, cA_, cB_, 
          cC_]\  := \ \[IndentingNewLine]\(u\ cA\  + \ v\ cB\  + \ w\ \
cC\)\/\(u + v + w\)\ \  /. \ {a \[Rule] Norm[cB - cC], 
            b \[Rule] Norm[cC - cA], c \[Rule] Norm[cA - cB]};\)\)], "Input",
  InitializationCell->True],

Cell[BoxData[
    \(\(\(Segmento[ptX_, ptY_, t1_, 
          t2_]\  := \ \[IndentingNewLine]Line[{ptX\  + t1\ \((ptY - ptX)\), 
            ptX\  + \ t2 \((ptY - ptX)\)}];\)\(\[IndentingNewLine]\)
    \)\)], "Input"],

